{
  "name": "antigravity-client",
  "version": "1.1.0",
  "description": "Universal, zero-dependency TypeScript client for Google Antigravity & Gemini AI. Works across Web, React, React Native, Mobile, Node.js, and Edge.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "tsx examples/demo.ts",
    "test": "tsx examples/demo.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaroslavSamchuk/AntigravityClient.git"
  },
  "bugs": {
    "url": "https://github.com/YaroslavSamchuk/AntigravityClient/issues"
  },
  "homepage": "https://github.com/YaroslavSamchuk/AntigravityClient#readme",
  "keywords": [
    "antigravity",
    "gemini",
    "google-auth",
    "oauth",
    "pkce",
    "react",
    "react-native",
    "universal",
    "zero-dependency"
  ],
  "author": "Yaroslav Samchuk",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
